# Параметры подключения к PostgreSQL / PostGIS
POSTGRES_USER=fuel_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=fuel_moscow_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# Сетевые порты внешних интерфейсов
PRESENTATION_PORT=8000

# Параметры LLM для аналитических справок (Gold Service)
LLM_PROVIDER=mock  # mock, openai, ollama
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=http://docker.internal
